# Orbi AI commerce agent: every setting the server reads. Copy to .env and fill in.
# Lines starting with "# NAME=" are optional and show the default. test/envExample.test.js fails when
# the code reads a setting that is missing here, or when a setting here is no longer used.

# ---- Server ---------------------------------------------------------------------------------------
PORT=3000
# production: dev/test routes stay off; https APP_URL and an AI key are required at start-up
NODE_ENV=development
APP_URL=https://your-tunnel.example.com
# How many proxies sit between the shopper and this server. Shopify's App Proxy is one; add one for each
# load balancer of your host (e.g. 2 behind Render/Railway/Heroku), or every shopper of a store shares one counter.
TRUST_PROXY_HOPS=1
# Set to 1 for a while to log which "visitor" each chat request is counted as (key, ip and X-Forwarded-For). If one
# shopper shows different keys on every request, TRUST_PROXY_HOPS is too low and the rate limit never fills.
# RATE_LIMIT_DEBUG=1
# A label for this deploy in error reports (e.g. a git commit)
# RELEASE=

# ---- Database ---------------------------------------------------------------------------------------
MONGODB_URI=mongodb://127.0.0.1:27017/mini-agent
DB_NAME=mini-agent
# DB_BUFFER_TIMEOUT_MS=5000
# DB_SERVER_SELECTION_TIMEOUT_MS=10000
# DB_MAX_POOL_SIZE=20

# ---- Shopify app (OAuth / Admin API / App Proxy) -------------------------------------------------------
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# older names for the same two values
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_OAUTH_REDIRECT_URI=https://your-tunnel.example.com/api/shopify/oauth/callback
# Must match [access_scopes] in shopify.app.ai-commerce-agent.toml
SHOPIFY_SCOPES=read_products,read_inventory,read_locations,read_customers,write_customers,read_orders,write_orders,read_draft_orders,write_draft_orders,read_discounts,read_legal_policies
SHOPIFY_API_VERSION=2026-10
# true = ask Shopify for expiring offline tokens (refreshed automatically)
# SHOPIFY_REQUEST_EXPIRING_TOKENS=false
# SHOPIFY_QUOTE_TIMEOUT_MS=8000
# Opening the app swaps the admin session for an offline token only when needed, and at least this often
# TOKEN_EXCHANGE_REFRESH_HOURS=24
# Webhooks are answered at once and their work retried by the server: attempts before giving up, and how often to retry
# WEBHOOK_MAX_ATTEMPTS=8
# WEBHOOK_RETRY_SECONDS=30

# Encryption key for stored Shopify tokens: 32 random bytes, base64 (node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
SHOPIFY_TOKEN_ENCRYPTION_KEY=
# older name for the same key (leave empty; if both are set they must be equal)
TOKEN_ENCRYPTION_KEY=
# Old keys still accepted for reading, comma separated, while rotating (see scripts/rotate-token-key.mjs)
# TOKEN_ENCRYPTION_PREVIOUS_KEYS=

# ---- Secrets (generate once, keep, never share) ----------------------------------------------------------
# Signs the email one-time-code sessions
OTP_HMAC_SECRET=
# Signs the public chat reference used to attribute orders to chats (changing it breaks carts already tagged)
ANALYTICS_HMAC_SECRET=

# ---- AI models: the primary is tried first, then the secondary ---------------------------------------------
LLM_PRIMARY=gemini
LLM_SECONDARY=claude
# older name for LLM_PRIMARY; when set it wins over LLM_PRIMARY, so leave it empty
# LLM_PROVIDER=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# older name for the Gemini key
GEMINI_API=
# Groq is retired: nothing is sent to it. Left only so an old .env still loads.
GROQ_API_KEY=
# CLAUDE_MODEL=claude-sonnet-5-5
# GEMINI_MODEL=gemini-3.1-flash-lite
# GROQ_MODEL=openai/gpt-oss-20b
# Comma-separated models your API account may use if the main one fails (each failed model cools down)
# CLAUDE_FALLBACK_MODELS=
# used when GEMINI_MODEL fails; default gemini-3.5-flash-lite
# GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite
# Model for short side calls (greeting, meaning match); default gemini-3.1-flash-lite
# GEMINI_LIGHT_MODEL=gemini-3.1-flash-lite
# GROQ_FALLBACK_MODELS=
# Voice calls: Gemini Live model
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
# off | low | medium | high (Gemini thinking; off is fastest)
# GEMINI_THINKING_LEVEL=off
# on = let Claude think before answering (slower, costs more)
# CLAUDE_THINKING=off
# CLAUDE_TIMEOUT_MS=15000
# GEMINI_TIMEOUT_MS=15000
# While another healthy Gemini model is next in line, a slow model is given up on after this long (ms)
# GEMINI_FAILOVER_TIMEOUT_MS=7000
# after this long with no answer from a Gemini model, the next healthy model is asked as well and the first answer is used (0 = off)
# GEMINI_HEDGE_MS=3000
# GROQ_TIMEOUT_MS=12000
# FINAL_REPLY_TIMEOUT_MS=12000
# A rate limit (429) is waited out: the longest total wait per model call, in ms (default 12000, 0 = never wait)
# RATE_LIMIT_MAX_WAIT_MS=12000
# Optional pacing: most Gemini calls per minute from this server (0 = off). Set it just under your plan's limit
# GEMINI_MAX_RPM=0
# LLM_MAX_OUTPUT_TOKENS=700
# LLM_REPLY_MAX_OUTPUT_TOKENS=1000
# Temperature of the written reply, and of the rounds that pick tools (carts, orders, cancellations)
# LLM_TEMPERATURE=0.6
# LLM_TOOL_TEMPERATURE=0.25
# How many tool rounds one customer message may use (1-4), and how many earlier messages the model sees (6-30)
# MAX_TOOL_ROUNDS=3
# MAX_HISTORY_MESSAGES=16
# After this many ms into one message, optional extra AI calls (guard rewrites) are skipped and the ready reply is sent
# TURN_SOFT_DEADLINE_MS=15000
# The AI writes the chat's opening message and the suggestion chips; how long each may take
# GREETING_TIMEOUT_MS=6000
# SUGGESTION_TIMEOUT_MS=4000
# 0 = the reply round drops the tool list (smaller prompt, no cache reuse)
# FINAL_ROUND_KEEP_TOOLS=1
# The quick catalog probe never delays the first AI call by more than this
# PROBE_BUDGET_MS=700
# ai (default): the AI words every reply, checked against verified data | verified_templates: fixed checkout wording
# REPLY_STYLE=ai
# older switch for the same choice (0 = verified_templates)
# LLM_PHRASE_CHECKOUT=1
# Prices per million tokens, to report the AI cost in /metrics (by model name, or provider name as a fallback)
# LLM_PRICES_JSON={"gemini-3.1-flash-lite":{"input":0.1,"output":0.4,"cached":0.025},"groq":{"input":0.1,"output":0.5}}

# ---- Email (order confirmations, order-lookup codes): Gmail App Password ------------------------------------
EMAIL_USER=
EMAIL_APP_PASSWORD=
EMAIL_FROM=
# How long checkout waits for the confirmation email before answering
# ORDER_EMAIL_WAIT_MS=2500
# Order confirmations and owner alerts that fail for a passing reason are sent again: tries, and how often to check
# EMAIL_MAX_ATTEMPTS=6
# EMAIL_RETRY_SECONDS=60
# false = Shopify does not email the customer when the agent cancels an order
# NOTIFY_CUSTOMER_ON_CANCEL=true

# ---- Order lookup by email code ---------------------------------------------------------------------------
# How long a verified email keeps working on one device (renewed on every use)
# ORDER_LOOKUP_VERIFIED_DAYS=1

# ---- Call booking -> Google Calendar (optional) ------------------------------------------------------------
# A Google Cloud service account key (raw JSON or base64) with the Calendar API enabled; each store owner shares
# their calendar with its email ("Make changes to events") and enters the calendar ID in Agent settings.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Fallback calendar for a store that has not entered its own
GOOGLE_CALENDAR_ID=

# ---- What the assistant may tell shoppers -----------------------------------------------------------------
# Discount codes it may mention: public (every buyer, unlimited uses) | none | all
# DISCOUNT_CODE_SHARING=public
# 1 = it may name products you have not published to the Online Store
# SHARE_UNPUBLISHED_TITLES=0
# Exact stock is shown only at or below this many units ("Only 3 left")
# LOW_STOCK_THRESHOLD=5
# Addresses it may give: pickup (locations with local pickup) | all | none
# STORE_ADDRESS_SHARING=pickup
# Name the assistant uses when the store owner has not chosen one
# AGENT_NAME=Orbi
# A prepaid-payment offer when the store has no Shopify discount for it (percent or flat amount, and its code)
# PREPAID_DISCOUNT_PERCENT=0
# PREPAID_DISCOUNT_FLAT=0
# PREPAID_DISCOUNT_CODE=
# Words that mark a Shopify discount as the prepaid offer (comma separated)
# PREPAID_DISCOUNT_MATCH=prepaid

# ---- Store owner dashboard and analytics ------------------------------------------------------------------
# Chat transcripts are deleted after this many days (owners can choose 7-365 in their settings)
# MESSAGE_RETENTION_DAYS=90
# Analytics events (no personal data) are kept this long
# EVENT_RETENTION_DAYS=400
# An order counts as coming from a chat if the chat was within this many days before it
# ATTRIBUTION_WINDOW_DAYS=7
# After this many quiet minutes a returning shopper starts a new conversation
# RETURNING_AFTER_MINUTES=30
# How long a store's settings are cached (dashboard changes apply within this time)
# SETTINGS_CACHE_SECONDS=60
# ADMIN_RATE_LIMIT_PER_MINUTE=240

# ---- Rate limits -------------------------------------------------------------------------------------------
# A shopper is counted by their signed Shopify customer id, or else by their network (IPv6: its /64); the browser's
# chat id is never used. Counters live in MongoDB, so they hold across restarts and server instances.
# Per shopper, per minute:
# CHAT_RATE_LIMIT=30            # chat messages and greetings
# CHAT_RATE_WINDOW_MS=60000
# LIGHT_RATE_LIMIT=20           # voice and upload tokens, clearing a chat
# STAFF_POLL_RATE_LIMIT=40      # the window checking for the team's replies
# UPLOAD_RATE_LIMIT=12
# SUGGESTION_RATE_LIMIT=40
# Per store, whoever asks: this keeps the AI bill bounded. 0 turns a ceiling off.
# SHOP_AI_RATE_LIMIT_PER_MINUTE=240   # chat, greetings, suggestions and voice sessions together
# SHOP_AI_LIMIT_PER_DAY=15000         # the day starts at 00:00 UTC
# SHOP_UPLOAD_RATE_LIMIT_PER_MINUTE=60
# SHOP_UPLOAD_LIMIT_PER_DAY=2000

# ---- Voice calls -----------------------------------------------------------------------------------------
# VOICE_MAX_PER_SHOP=25
# VOICE_MAX_TOTAL=200
# VOICE_MAX_MINUTES=30
# VOICE_IDLE_SECONDS=180
# VOICE_MAX_CHUNKS_PER_SECOND=40
# How long a voice/upload token lives before it is used (each token works once)
# VOICE_TOKEN_TTL_SECONDS=120
# 1 = also accept the old "?token=" in the socket URL, only for a few minutes after deploying the new widget
# VOICE_TOKEN_IN_URL=0
# Words "heard" while the microphone carried less voice than this (in the last window) are ignored; 0 = off
# VOICE_MIN_VOICED_MS=200
# VOICE_SPEECH_WINDOW_MS=5000
# Loudness below which nothing counts as voice, and how far above the room's noise voice must be
# VOICE_SPEECH_MIN_LEVEL=0.003
# VOICE_SPEECH_NOISE_RATIO=3
# When Gemini Live receives speech but writes none of it down, the connection is replaced and the speech replayed:
# how much voiced audio counts as speech, how long to wait for its transcript, and how often a replacement may happen.
# 1 = let Gemini Live decide when the shopper starts and stops talking (default: this server's own speech detector does)
# VOICE_GEMINI_VAD=0
# VOICE_WATCHDOG_MIN_VOICED_MS=700
# VOICE_WATCHDOG_WAIT_MS=3500
# VOICE_WATCHDOG_COOLDOWN_MS=15000
# How long to wait after the shopper's words before answering (a chunk / after Gemini says the turn is complete)
# VOICE_SETTLE_MS=1000
# VOICE_TURN_COMPLETE_SETTLE_MS=400
# While voice still came in this recently the answer waits (a pause mid-sentence), up to the extra wait in all
# VOICE_STILL_SPEAKING_MS=800
# VOICE_MAX_EXTRA_WAIT_MS=2500
# Writing systems (Unicode script names) to accept besides the reply languages' own, e.g. Arabic,Tamil
# VOICE_EXTRA_SCRIPTS=

# ---- Shopper files (photos, videos, PDFs) -----------------------------------------------------------------
# Storage per store for shopper files; new files are refused above it (0 = no limit)
# SHOP_ATTACHMENT_QUOTA_MB=1024
# Uploads handled at once by one server (each holds at most one file in memory)
# MAX_CONCURRENT_UPLOADS=4
# Where uploads wait while they are checked (default: the system temp folder)
# UPLOAD_TMP_DIR=
# How many photos/PDFs the AI looks at per message, and the largest it looks at
# MAX_FILES_TO_AI=3
# MAX_FILE_MB_TO_AI=5
# mongo (default): files in MongoDB | s3: any S3-compatible storage (AWS S3, Cloudflare R2, Backblaze B2, MinIO)
# ATTACHMENT_STORAGE=mongo
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PREFIX=attachments
# Timeout for each object storage request, in milliseconds (default 15000).
# S3_TIMEOUT_MS=15000
# How often expired files are removed from object storage
# ATTACHMENT_SWEEP_MINUTES=30
# Virus scan with ClamAV (clamd). When set, files are refused while the scanner is unreachable,
# unless CLAMAV_FAIL_OPEN=1.
# CLAMAV_HOST=
# CLAMAV_PORT=3310
# CLAMAV_TIMEOUT_MS=10000
# CLAMAV_FAIL_OPEN=0

# ---- Logs, metrics, errors, alerts ---------------------------------------------------------------------------
# error | warn | info | debug (production default info)
LOG_LEVEL=
# json = one JSON object per line (for log collectors)
LOG_FORMAT=
# 1 = show (redacted) shopper text in logs while developing; ignored in production
# LOG_CUSTOMER_TEXT=0
# GET /metrics (Prometheus) is served only with "Authorization: Bearer <this>"; at least 24 characters
# METRICS_TOKEN=
# Errors to Sentry: https://<key>@<host>/<project id>
# SENTRY_DSN=
# Alerts to a Slack or Discord incoming webhook (https)
# ALERT_WEBHOOK_URL=
# ALERT_MIN_INTERVAL_MINUTES=15
# Name of this environment in alert messages (default: NODE_ENV)
# ALERT_ENVIRONMENT=
# Process caches (catalog, search, policies)
# CACHE_MAX_AGE_MS=3600000

# How old (in seconds) a copy of the store catalog may be before it is never shown any more. Prices and stock come from
# Shopify; a copy up to this age is shown instantly while a fresh one loads in the background. Default 300 (5 minutes).
# CATALOG_STALE_MAX_SECONDS=300
# CACHE_MAX_ENTRIES=5000

# ---- Live help from a person (audio call in the chat) -------------------------------------------------------
# The audio goes browser to browser (WebRTC). STUN finds the way; TURN relays the audio on networks that block a direct path.
# Without TURN, calls work on most networks but not on every one. Run your own coturn (free) or rent one.
# Comma separated stun: addresses (default: Google's public STUN)
# SUPPORT_STUN_URLS=stun:stun.l.google.com:19302
# turn: / turns: addresses of your TURN server, e.g. turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349
# SUPPORT_TURN_URLS=
# Either the coturn "static-auth-secret" (short-lived credentials are made for each call) ...
# SUPPORT_TURN_SECRET=
# ... or one fixed username and password
# SUPPORT_TURN_USERNAME=
# SUPPORT_TURN_CREDENTIAL=
# Seconds a request waits for a person before it is closed as unanswered (default 90)
# SUPPORT_REQUEST_TTL_SECONDS=90
# Seconds a team member's browser may stay silent before they stop counting as available (default 45)
# SUPPORT_PRESENCE_FRESH_SECONDS=45
# Seconds the server waits for a shopper to come back after a connection drop before it ends the call (default 20)
# SUPPORT_CUSTOMER_GRACE_SECONDS=20
# Hours a call window stays signed in (default 10). Calls are taken in a separate window because Shopify's admin gives an
# embedded app no microphone; the window signs in with a one-time key made by the dashboard.
# SUPPORT_CONSOLE_HOURS=10
# The most audio kept for one recorded call, in MB (default 14, about 75 minutes)
# SUPPORT_MAX_RECORDING_MB=14
# Requests per minute per shopper: any support call, and asking for a call / booking a callback (defaults 60 and 12)
# SUPPORT_RATE_LIMIT=60
# SUPPORT_REQUEST_RATE_LIMIT=12

# ---- Development only -----------------------------------------------------------------------------------------
# 1 = also let local pages (localhost) call the storefront routes in production (off by default)
# CORS_ALLOW_LOCALHOST=0
# 1 = local test pages (always off when NODE_ENV=production)
ENABLE_DEV_ROUTES=

# ---- Prices and currency --------------------------------------------------------------------------------------
# By default everything (cards, replies, cart, checkout, order, email) is in the STORE's own currency, whatever Shopify
# Markets currency the visitor browses in. 1 = follow the visitor's market currency instead.
STORE_PRICES_FOLLOW_MARKET=

# ---- Store contact ----------------------------------------------------------------------------------------------
# The shop contact email is not given to shoppers when it is a personal mailbox (gmail.com, outlook.com ...). 1 = share it anyway.
SHARE_PERSONAL_CONTACT_EMAIL=
